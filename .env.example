# Local access to the MusicRepo Supabase corpus (works + representations),
# used by tools/corpus-fetch/fetch-corpus.sh to populate .corpus-cache/.
# Copy to `.env` (gitignored) and fill in your project ref + password from:
#   Supabase dashboard → Project Settings → Database → Connection string → "Session pooler"
# Format (session pooler, IPv4-friendly, port 5432):
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<PASSWORD>@<POOLER_HOST>:5432/postgres
