{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-fullscreen",
    "core:webview:default",
    "core:app:default",
    "core:tray:default",
    "opener:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-ask",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "updater:default",
    "notification:default",
    "store:default",
    "allow-send-message",
    "allow-updater-install-kind",
    "allow-relaunch-app",
    "allow-validate-pattern",
    "allow-inspect-pattern",
    "allow-analyze-arrangement",
    "allow-detect-pattern-length",
    "allow-critique-pattern",
    "allow-critique-form",
    "allow-genre-recipe",
    "allow-get-pattern-history",
    "allow-get-config",
    "allow-clear-session",
    "allow-open-file",
    "allow-save-current",
    "allow-save-as",
    "allow-new-file",
    "allow-is-dirty",
    "allow-get-current-file",
    "allow-get-recents",
    "allow-clear-recents",
    "allow-session-undo",
    "allow-session-redo",
    "allow-get-library-root",
    "allow-set-library-root",
    "allow-list-library",
    "allow-create-library-folder",
    "allow-create-library-file",
    "allow-delete-library-path",
    "allow-rename-library-path",
    "allow-reveal-in-os",
    "allow-autosave-session",
    "allow-restore-session",
    "allow-tray-set-playback",
    "allow-import-midi",
    "allow-inspect-midi",
    "allow-save-midi-to-library",
    "allow-get-user-settings",
    "allow-set-user-settings",
    "allow-set-provider-key",
    "allow-has-provider-key",
    "allow-xai-oauth-status",
    "allow-xai-oauth-import-grok-build",
    "allow-xai-oauth-start-login",
    "allow-xai-oauth-poll-login",
    "allow-xai-oauth-logout",
    "allow-codex-oauth-status",
    "allow-codex-oauth-import-cli",
    "allow-codex-oauth-login",
    "allow-codex-oauth-logout",
    "allow-get-app-info",
    "allow-recording-open",
    "allow-recording-write",
    "allow-recording-close",
    "allow-recording-orphans",
    "allow-recording-recover",
    "allow-export-audio",
    "allow-export-midi",
    "allow-list-snapshots",
    "allow-read-snapshot",
    "allow-get-logs",
    "allow-clear-logs",
    "allow-log-diagnostic",
    "allow-diagnostic-dump",
    "allow-set-dock-badge",
    "allow-scan-sample-folder",
    "allow-read-audio-file",
    "allow-register-sound-banks",
    "allow-list-sounds",
    "allow-list-packs",
    "allow-enable-pack",
    "allow-disable-pack",
    "allow-load-enabled-packs",
    "allow-packs-dir",
    "allow-install-pack-from-folder",
    "allow-list-sample-sets",
    "allow-download-sample-set",
    "allow-remove-sample-set",
    "allow-get-active-sample-set-manifests",
    "allow-list-midi-input-devices",
    "allow-start-midi-input-listening",
    "allow-stop-midi-input-listening",
    "allow-get-midi-input-status"
  ]
}
