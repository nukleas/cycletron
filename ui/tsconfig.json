{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "useDefineForClassFields": false,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "preserveConstEnums": false,
    "preserveWatchOutput": true,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "src",
    "audio-manager.ts",
    "scheduler.ts",
    "sample-loader.ts",
    "polyfills.ts",
    "query-profiler.ts",
    "soundfont-tables.ts",
    "worklet.ts",
    "worklet-types.d.ts",
    "pkg/*.d.ts",
    "global.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "vite.config.ts"
  ]
}