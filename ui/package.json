{
  "name": "cycletron-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:wasm",
    "dev": "vite --port 5173",
    "prebuild": "npm run build:wasm",
    "build": "vite build",
    "preview": "vite preview --port 5173",
    "build:wasm": "cd ../../strudel-rs/crates/strudel-audio-wasm && env RUSTUP_TOOLCHAIN=nightly wasm-pack build . --target web --out-dir ../../../cycletron/ui/pkg -- -Z build-std=std,panic_abort"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.1",
    "@codemirror/lint": "^6.0.0",
    "@lezer/highlight": "^1.2.0",
    "@lezer/javascript": "^1.5.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-store": "^2.4.3",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "codemirror": "^6.0.1",
    "coi-serviceworker": "^0.1.7",
    "marked": "^15.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "unplugin-inline-enum": "^0.6.4",
    "vite": "^6.4.1",
    "vite-plugin-tsc": "^0.1.1"
  }
}
