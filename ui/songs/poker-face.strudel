setcpm(30)

// Track 1: Poker face (C:chromatic)
$: note(`<
    - [G#3 G#3 G#2 G#2 D#3 D#3 G#2 G#2] [G#3 G#3 E3 B2 F#3 F#3 F#2 F#2] [G#3 G#3 G#2 G#2 D#3 D#3 G#2 G#2]
    [G#3 G#3 E3 B2 F#3 F#3 F#2 F#2] [G#3 G#3 G#2 G#2 D#3 D#3 G#2 G#2] [G#3 G#3 E3 B2 F#3 F#3 F#2 F#2] [G#3 G#3 G#2 G#2 D#3 D#3 G#2 G#2]>`).sound("supersaw").release(0.07).gain(0.85).room(0.65).vibrato(0.5)
// Track 2: Poker face (C:chromatic)
$: note(`<
    - - - [[G#2,G#3] [G#2,G#3] [G#1,G#2] [G#1,G#2] [D#2,D#3] [D#2,D#3] [G#1,G#2] [G#1,G#2]]
    [[G#2,G#3] [G#2,G#3] [E2,E3] [B1,B2] [F#2,F#3] [F#2,F#3] [F#1,F#2] [F#1,F#2]] [[G#2,G#3] [G#2,G#3] [G#1,G#2] [G#1,G#2] [D#2,D#3] [D#2,D#3] [G#1,G#2] [G#1,G#2]] [[G#2,G#3] [G#2,G#3] [E2,E3] [B1,B2] [F#2,F#3] [F#2,F#3] [F#1,F#2] [F#1,F#2]] [[G#2,G#3] [G#2,G#3] [G#1,G#2] [G#1,G#2] [D#2,D#3] [D#2,D#3] [G#1,G#2] [G#1,G#2]]>`).sound("supersaw").release(0.05).gain(0.90).room(0.58).vibrato(0.5)
// Track 3: Poker face (C:phrygian)
$: note(`<
    - - - -
    [- - - - - G#3 G#3 G#3] G#3 [- - - - - G#3 G#3 G#3] G#3>`).sound("supersaw").release(0.11).room(0.58).vibrato(0.5)
// Track 4: Poker face (C:chromatic)
$: note(`<
    - - - -
    - [B3 B3 B3 B3 B3 B3 B3 B3] [B3 B3 B3 B3 C#4 B3 C#4 B3] [D#4 D#4 D#4 D#4 D#4 D#4 D#4 D#4]>`).sound("supersaw").release(0.07).room(0.58).vibrato(0.5)
