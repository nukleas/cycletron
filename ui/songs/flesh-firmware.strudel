    s("< [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [~ sd ~ [sd sd sd ~]] >")
      .hpf(200).room(0.18).gain(0.38),
    s("hh*16").gain("[0.085 0.03 0.055 0.03]*4").pan(0.63),
    note("<[d2 ~ d2 a2 ~ d3 c3 a2] [eb2 ~ eb2 bb2 ~ a2 g2 ~] [d2 ~ d2 a2 ~ c3 a2 ~] [a1 ~ a2 ~ c#3 ~ e2 ~]>")
      .s("sawtooth").lpf(saw.range(650, 1700).slow(16)).resonance(2)
      .decay(0.12).sustain(0).release(0.06).dist(0.22).gain(0.27),
    note("<[d4 [f4 a4] ~ c5 a4 ~ [g4 f4] e4] [eb4 g4 bb4 [d5 c5] bb4 ~ g4 eb4] [d4 f4 [a4 c5] d5 ~ c5 a4 g4] [a4 ~ g4 e4 c#4 e4 a4 ~]>")
      .every(8, x => x.rev())
      .s("sawtooth").vowel("0 2 1 3").lpf(3800).attack(0.012)
