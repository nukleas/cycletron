    note("<[d5 ~ ~ ~ ~ a5 ~ ~] [~ ~ c6 ~ a5 ~ ~ ~] [f5 ~ ~ ~ e5 ~ ~ ~] [d5 ~ ~ ~ ~ ~ ~ ~]>")
      .s("fm").fmratio(2).fmindex(2.2).decay(0.09).sustain(0).release(0.1)
      .delay(0.28).delaytime(0.3515625).delayfeedback(0.3).room(0.35).gain(0.12).pan(0.3),
    note("d1").slow(2).s("sine").attack(0.4).release(0.8).gain(0.2)
  ),

  robots: stack(
