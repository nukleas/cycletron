    note("<[d2 ~ d2 a2 ~ c3 a2 ~] [d2 ~ d2 ~ f2 ~ e2 ~] [bb1 ~ bb1 f2 ~ a2 f2 ~] [c2 ~ c2 g2 ~ e2 c2 ~]>")
      .s("sawtooth").lpf(720).resonance(2).decay(0.12).sustain(0).release(0.07)
      .dist(0.18).gain(0.26),
    note("<[d5 a5 c6 a5 f5 e5 d5 ~] [d5 ~ a5 ~ c6 a5 ~ ~] [d5 a5 c6 a5 f5 e5 d5 ~] [f5 ~ e5 ~ d5 ~ ~ ~]>")
      .every(8, x => x.rev())
      .s("fm").fmratio(2).fmindex("<2 3 2 4>").decay(0.07).sustain(0).release(0.06)
      .lpf(4800).delay(0.16).delaytime(0.234375).gain(0.14).pan(0.28)
