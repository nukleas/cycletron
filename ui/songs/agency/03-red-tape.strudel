---
name: "Robostrudel Session"
bpm: 128
created: 2026-07-14
tags: [robostrudel]
---
// AGENCY OST — 03 · Red Tape
// Bureaucracy as a boss fight. EBM: mechanical stomp, rolling 16th bass,
// shouted stabs. C# phrygian — the flat-2 (D natural) is the form that
// keeps coming back stamped DENIED. The big clap is the rubber stamp.
//
// FORM (128 BPM · 1 cycle = 1 bar · 68 bars ≈ 2:08 · loops):
//   intro   8  e2  the stamp machine: euclid rimshots, hats, cold drone
//   stomp   16 e3  + four-on-floor, backbeat snare, the rolling bass
//   stabs   16 e4  + shouted stabs, metallic percussion, the STAMP
//   choke   8  e2  audit pause — bass and drone alone, forms shuffling
//   stomp2  16 e5  everything, filter open, oh — appeal DENIED
//   outro   4  e1  the machine powers down mid-form
// hook: the rolling phrygian bass — relentless, all sections but choke's start.

setbpm(128);

"<intro@2 stomp@4 stabs@4 choke@2 stomp2@4 outro>".slow(4).pickRestart({
  intro: stack(
    s("rs(5,16)").gain(0.3).hpf(4000).dist(0.2).pan(0.35),
    s("~ hh ~ hh ~ hh ~ hh").gain(0.3).hpf(5000)
  ),
  stomp: stack(
    s("bd*4").gain(0.92).dist(0.15),
    s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~").gain(0.6),
    s("~ hh ~ hh ~ hh ~ hh").gain(0.32).hpf(5000),
    note("<[c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 c#2 c#3 c#2 e2 c#2 c#3 c#2 f#2 e2 d2 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 g#1 g#1 g#2 g#1 a1 a1 a2 a1] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [f#2 f#2 f#3 f#2 e2 e2 e3 e2 d2 d2 d3 d2 c#2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 d2 d3 d2 b1 b1 b2 b1 c#2 c#2 c#3 c#2]>")
      .s("sawtooth").lpf(850).resonance(7).dist(0.18)
      .decay(0.1).sustain(0).gain("0.85 0.55 0.7 0.55"),
    
  ),
  stabs: stack(
    s("bd*4").gain(0.93).dist(0.18),
    s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~").gain(0.62),
    s("~ hh ~ hh ~ hh ~ hh").gain(0.32).hpf(5000),
    s("<[~ ~ ~ ~] [~ ~ cp ~]>").room(0.6).roomsize(0.8).gain(0.55),
    s("ht(3,16,2)").gain(0.32).crush(6).hpf(600).pan(0.62),
    note("<[c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 c#2 c#3 c#2 e2 c#2 c#3 c#2 f#2 e2 d2 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 g#1 g#1 g#2 g#1 a1 a1 a2 a1] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [f#2 f#2 f#3 f#2 e2 e2 e3 e2 d2 d2 d3 d2 c#2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 d2 d3 d2 b1 b1 b2 b1 c#2 c#2 c#3 c#2]>")
      .s("sawtooth").lpf(950).resonance(7).dist(0.2)
      .decay(0.1).sustain(0).gain("0.85 0.55 0.7 0.55"),
    note("<[~ c#4 ~ ~ ~ c#4 ~ e4] [~ d4 ~ ~ ~ c#4 ~ b3] [~ c#4 ~ ~ ~ e4 ~ f#4] [~ d4 ~ c#4 ~ ~ b3 ~] [~ c#4 ~ ~ ~ c#4 ~ e4] [~ e4 ~ ~ ~ d4 ~ c#4] [~ f#4 ~ ~ ~ e4 ~ d4] [~ c#4 ~ ~ c#4 ~ ~ ~]>")
      .s("supersquare").decay(0.12).sustain(0).release(0.08)
      .lpf(2600).resonance(6).dist(0.3)
      .delay(0.2).delaytime(0.375).delayfeedback(0.3)
      .gain(0.46).pan(0.55)
  ),
  choke: stack(
    note("<[c#2 ~ ~ c#2 ~ ~ d2 ~] [c#2 ~ ~ c#2 ~ ~ b1 ~] [c#2 ~ ~ c#2 ~ ~ d2 ~] [e2 ~ d2 ~ c#2 ~ ~ ~]>")
      .s("sawtooth").lpf(600).resonance(6).dist(0.12)
      .decay(0.12).sustain(0).gain(0.5),
    s("rs(3,8)").gain(0.24).hpf(4000).dist(0.2).pan(0.4)
  ),
  stomp2: stack(
    s("bd*4").gain(0.95).dist(0.2),
    s("~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~").gain(0.64),
    s("~ hh ~ hh ~ hh ~ hh").gain(0.32).hpf(5000),
    s("~ ~ oh ~").gain(0.24).hpf(4000),
    s("<[~ ~ ~ ~] [~ ~ cp ~]>").room(0.6).roomsize(0.8).gain(0.58),
    s("ht(3,16,2)").gain(0.32).crush(6).hpf(600).pan(0.62),
    note("<[c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 c#2 c#3 c#2 e2 c#2 c#3 c#2 f#2 e2 d2 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 g#1 g#1 g#2 g#1 a1 a1 a2 a1] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 c#2 c#2 c#3 c#2 c#2 d2 c#3 c#2 e2 c#2 c#3 c#2] [f#2 f#2 f#3 f#2 e2 e2 e3 e2 d2 d2 d3 d2 c#2 c#2 c#3 c#2] [c#2 c#2 c#3 c#2 d2 d2 d3 d2 b1 b1 b2 b1 c#2 c#2 c#3 c#2]>")
      .s("sawtooth").lpf(saw.range(900, 1500).slow(16)).resonance(8).dist(0.24)
      .decay(0.1).sustain(0).gain("0.85 0.55 0.7 0.55"),
    note("<[~ c#4 ~ ~ ~ c#4 ~ e4] [~ d4 ~ ~ ~ c#4 ~ b3] [~ c#4 ~ ~ ~ e4 ~ f#4] [~ f#4 ~ e4 ~ d4 c#4 ~] [~ e4 ~ ~ ~ f#4 ~ g#4] [~ f#4 ~ ~ ~ e4 ~ d4] [~ c#4 ~ ~ ~ d4 ~ e4] [~ d4 c#4 ~ c#4 ~ ~ ~]>")
      .s("supersquare").decay(0.12).sustain(0).release(0.08)
      .lpf(2800).resonance(6).dist(0.3)
      .delay(0.2).delaytime(0.375).delayfeedback(0.3)
      .gain(0.46).pan(0.55)
  ),
  outro: stack(
    s("bd ~ ~ ~").gain(0.8).dist(0.15),
    s("rs(5,16)").gain(isaw.range(0.08, 0.28).slow(4)).hpf(4000).pan(0.35),
    note("<[c#3, e3, g#3, b3] [a2, c#3, e3, g#3]>").s("superpwm")
      .attack(1.4).release(4).lpf(isaw.range(300, 1000).slow(4))
      .gain(0.28).room(0.7).roomsize(0.85)
  )
})
