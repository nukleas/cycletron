// AGENCY OST — 02 · Ticket Queue
// Fluorescent office, endless forms, quiet dread. Synthwave with a darksynth edge.
//
// FORM (100 BPM · 1 cycle = 1 bar · 40 bars ≈ 1:36 · loops):
//   intro    4  e1  mainframe hum + clock tick + cold pad
//   verse    8  e2  + kick, chugging bass, typing pluck
//   lift     4  e3  + backbeat snare, climbing arp, filter opens
//   chorus   8  e4  full: gated snare, wide pad, the queue theme (falling lead)
//   break    4  e2  drums out — pad + typing alone under the hum
//   chorus2  8  e4  full + extra hats + octave lead double
//   outro    4  e1  filter closes, the tick remains
// hook: the queue theme — a resigned 4-bar falling line, both choruses.

setbpm(100);

"<intro verse@2 lift chorus@2 break chorus2@2 outro>".slow(4).pickRestart({
  intro: stack(
    note("f#1").s("sine").attack(1.5).release(2.5).slow(2).gain(0.4),
    s("rs*4").gain("0.25 0.18 0.22 0.18").pan(0.45),
    chord("<F#m F#m D Bm>").voicing().s("supersaw")
      .attack(0.6).release(1.2).lpf(900).chorus(0.4).room(0.5).roomsize(0.7).gain(0.26)
  ),
  verse: stack(
    note("f#1").s("sine").attack(1.5).release(2.5).slow(2).gain(0.18),
    s("bd*4").bank("LinnDrum").gain(0.82),
    s("rs*4").gain("0.18 0.12 0.16 0.12").pan(0.45),
    note("<[f#1 f#1 f#1 f#1] [f#1 f#1 f#1 f#1] [d1 d1 d1 d1] [b0 b0 c#1 c#1]>")
      .s("sawtooth").lpf(600).decay(0.2).sustain(0.3).dist(0.1).gain(0.46),
    note("<[7 7 ~ 7 ~ 7 7 ~] [7 9 ~ 7 ~ ~ 9 ~] [7 7 ~ 7 ~ 4 ~ 4] [5 ~ 5 ~ 2 ~ ~ ~]>")
      .scale("F#5:minor").s("pulse").decay(0.1).sustain(0)
      .delay(0.25).delaytime(0.45).orbit(1).gain(0.32).pan(0.6),
    chord("<F#m F#m D Bm>").voicing().struct("x*16").s("supersaw")
      .attack(0.005).release(0.06).hpf(180).lpf(1100).chorus(0.4)
      .velocity(saw.range(0.15, 1).fast(4)).gain(0.28)
  ),
  lift: stack(
    s("bd*4").bank("LinnDrum").gain(0.86),
    s("<[~ sd ~ sd] [~ sd ~ sd] [~ sd ~ sd] [sd*4 [sd sd sd sd sd sd sd sd]]>").bank("LinnDrum")
      .room(0.5).roomsize(0.7).gain("<0.55 0.55 0.55 [0.4 0.6]>"),
    note("<f#1*8 f#1*8 f#1*8 c#1*8>").s("sawtooth").lpf(650).decay(0.15).sustain(0.3).dist(0.12).gain(0.46),
    note("<[0 2 4 6 7 9 11 12] [2 4 6 7 9 11 12 14] [4 6 7 9 11 12 14 16] [7 9 11 12 14 16 18 19]>")
      .scale("F#4:minor").s("pulse")
      .decay(0.15).sustain(0.1).lpf(saw.range(800, 2600).slow(4))
      .delay(0.3).delaytime(0.45).orbit(1).gain(0.36),
    chord("<F#m D Bm C#m>").voicing().struct("x*16").s("supersaw")
      .attack(0.005).release(0.06).hpf(180).lpf(1400).chorus(0.4)
      .velocity(saw.range(0.15, 1).fast(4)).gain(0.30)
  ),
  chorus: stack(
    s("bd*4").bank("LinnDrum").gain(0.9),
    s("~ sd ~ sd").bank("LinnDrum").room(0.55).roomsize(0.7).gain(0.62),
    s("hh*8").bank("LinnDrum").gain("0.24 0.14 0.2 0.14").pan(sine.range(0.35, 0.65)),
    s("rs*4").gain(0.12).pan(0.45),
    // bass now follows the chords: F#m D Bm C#m
    note("<[f#1 f#2]*4 [d1 d2]*4 [b0 b1]*4 [c#1 c#2]*4>")
      .s("sawtooth").lpf(700).decay(0.18).sustain(0.25).dist(0.12).gain(0.46),
    note("<[7 ~ 6 ~ 4 ~ 2 ~] [4 ~ 2 ~ 0 ~ ~ ~] [6 ~ 4 ~ 2 ~ 1 ~] [2 ~ 0 ~ ~ ~ ~ ~]>")
      .scale("F#4:minor").s("wt_lead").release(0.4)
      .delay(0.2).delaytime(0.45).room(0.3).orbit(1).gain(0.56)
      .superimpose(x => x.s("supersaw").lpf(3200).gain(0.2)),
    chord("<F#m D Bm C#m>").voicing().struct("x*16").s("supersaw")
      .attack(0.005).release(0.06).hpf(200).lpf(1400).chorus(0.45)
      .velocity(saw.range(0.15, 1).fast(4)).gain(0.26)
  ),
  break: stack(
    note("f#1").s("sine").attack(1.5).release(2.5).slow(2).gain(0.4),
    s("rs*4").gain("0.22 0.15 0.2 0.15").pan(0.45),
    s("<~ ~ ~ [~ ~ ~ [sd sd sd sd]]>").bank("LinnDrum").gain("[0.2 0.3 0.4 0.5]").room(0.5).roomsize(0.7),
    note("<[7 7 ~ 7 ~ 7 7 ~] [~ 9 ~ 7 ~ ~ 9 ~] [7 ~ ~ 7 ~ 4 ~ 4] [5 ~ 5 ~ 2 ~ ~ ~]>")
      .scale("F#5:minor").s("pulse").decay(0.1).sustain(0)
      .delay(0.35).delaytime(0.45).room(0.4).orbit(1).gain(0.3).pan(0.6),
    chord("<F#m F#m Bm Bm>").voicing().s("supersaw")
      .attack(0.8).release(1.4).lpf(1000).chorus(0.5).room(0.6).roomsize(0.7).gain(0.26)
  ),
  chorus2: stack(
    s("bd*4").bank("LinnDrum").gain(0.9),
    s("~ sd ~ sd").bank("LinnDrum").room(0.55).roomsize(0.7).gain(0.62),
    s("hh*8").bank("LinnDrum").gain("0.24 0.14 0.2 0.14").pan(sine.range(0.35, 0.65)),
    s("~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh").gain(0.12).pan(0.3),
    note("<[f#1 f#2]*4 [d1 d2]*4 [b0 b1]*4 [c#1 c#2]*4>")
      .s("sawtooth").lpf(750).decay(0.18).sustain(0.25).dist(0.12).gain(0.44),
    // the theme with a true octave double (was a quarter-bar canon that
    // rubbed g#4 against a5)
    note("<[7 ~ 6 ~ 4 ~ 2 ~] [4 ~ 2 ~ 0 ~ ~ ~] [6 ~ 4 ~ 2 ~ 1 ~] [2 ~ 0 ~ ~ ~ ~ ~] [9 ~ 7 ~ 6 ~ 4 ~] [6 ~ 4 ~ 2 ~ ~ ~] [4 ~ 6 ~ 7 ~ 9 ~] [7 ~ ~ ~ ~ ~ ~ ~]>")
      .scale("F#4:minor").s("wt_lead").release(0.4)
      .delay(0.2).delaytime(0.45).room(0.3).orbit(1).gain(0.5)
      .superimpose(x => x.add(12).gain(0.24).lpf(2400), x => x.s("supersaw").lpf(3200).gain(0.2)),
    chord("<F#m D Bm C#m>").voicing().struct("x*16").s("supersaw")
      .attack(0.005).release(0.06).hpf(220).lpf(1500).chorus(0.45)
      .velocity(saw.range(0.15, 1).fast(4)).gain(0.24)
  ),
  outro: stack(
    note("f#1").s("sine").attack(1.5).release(2.5).slow(2).gain(0.38),
    s("rs*4").gain("0.22 0.15 0.2 0.15").pan(0.45),
    chord("<F#m F#m F#m F#m>").voicing().s("supersaw")
      .attack(0.8).release(1.6).lpf(isaw.range(300, 1400).slow(4))
      .chorus(0.5).room(0.6).roomsize(0.7).gain(0.26)
  )
})
