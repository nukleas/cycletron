    s("~ cp ~ cp").gain(0.7).hpf(1000).dist(0.2).room(0.2),
    s("~ oh ~ oh").gain(0.4).hpf(4500).pan(0.62),
    s("hh*16").gain("0.25 0.42 0.3 0.46").hpf(7000).pan(0.32),
    s("~ rim ~ ~ rim ~ ~ rim").gain(0.34).hpf(1800).dist(0.25).room(0.12).pan(0.68),
    s("<[~ ~ ~ ~] [~ ~ ~ [ht mt]]>").gain(0.35).crush(6).hpf(700).pan(0.6),
    note("<[f2 f2 f3 f2 ab2 f2 c3 f2 f2 eb3 f2 f3 gb2 f2 c3 f2] [f2 f2 f3 f2 ab2 f2 c3 f2 db3 c3 ab2 f2 gb2 f2 eb3 c3]>")
      .s("superzow").hpf(160).lpf(sine.range(700, 5200).slow(4)).resonance(19)
      .decay(0.16).sustain(0.08).dist(0.55).gain(0.62).pan(0.45)
