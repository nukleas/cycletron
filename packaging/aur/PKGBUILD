# Maintainer: nukleas <https://github.com/nukleas>
#
# Binary repack of the released .deb (see issue #5). This file is the source
# of truth for the AUR `cycletron-bin` package; a release-workflow job will
# stamp pkgver/sha256sums and push it to the AUR once a deploy key is set up.
#
# AUR pkgver cannot contain hyphens, so the release tag 0.1.0-alpha.N becomes
# pkgver 0.1.0alpha.N; _tag keeps the real tag for the download URL.

pkgname=cycletron-bin
_tag=0.1.0-alpha.20
pkgver=0.1.0alpha.20
pkgrel=1
pkgdesc="Live coding for music, built on Rust — fast native desktop instrument"
arch=('x86_64')
url="https://github.com/nukleas/cycletron"
license=('AGPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'libayatana-appindicator')
provides=('cycletron')
conflicts=('cycletron')
options=('!strip')
source=("https://github.com/nukleas/cycletron/releases/download/v${_tag}/Cycletron_${_tag}_amd64.deb")
sha256sums=('de0ab62a0971c1d0044925e1c9c4be495e4a82a43e91fe4ee5caddf3f031192a')

package() {
    bsdtar -xf data.tar.gz -C "$pkgdir"
}
