// AABB form using `pickRestart`: a section timeline switches named phrases.
// Each token in `<a a b b>` lasts one cycle, so the form is A, A, B, B.
setbpm(100);

$: "<a a b b>"
  .pickRestart({
    a: note("c3 ~ c3 ~ eb3 ~ c3 ~").s("sawtooth"),
    b: note("c3 d3 eb3 f3 g3 f3 eb3 d3").s("sawtooth")
  })
  .cutoff(900)
  .gain(0.6)
