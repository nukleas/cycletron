// Four-cycle build and drop: layers add in, strip to kick, then full drop.
setbpm(128);

stack(
  s("bd*4").gain(0.88),
  s("~ sd ~ sd").mask("<0 1 0 1>").gain(0.72),
  s("hh*8").mask("<0 0 0 1>").gain(0.28),
  note("<c2 c2 c2 eb2>")
    .s("sawtooth")
    .mask("<1 1 0 1>")
    .cutoff(700)
    .resonance(6)
    .gain(0.58)
)
