// Palindromic motif: the phrase reads the same forwards and backwards.
// Base motif "c4 e4 g4 b4" reflected around its last note — a symmetric
// arch form. Mirroring is one of total-serialism's transforms.
setbpm(96);

note("c4 e4 g4 b4 g4 e4 c4")
  .s("triangle")
  .attack(0.01)
  .release(0.3)
  .gain(0.6)
