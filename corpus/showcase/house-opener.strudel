// Live-set style house groove · 128 BPM
setbpm(128);

stack(
  s("bd*4").gain(0.9),
  s("~ hh*2 ~ hh*3").gain(0.5),
  note("<c2 c2 eb2 g2>/4")
    .s("sawtooth")
    .cutoff(400)
    .gain(0.7),
  note("<[c4,eb4,g4] [c4,eb4,g4] [eb4,g4,bb4] [g4,bb4,d5]>")
    .s("triangle")
    .cutoff(800)
    .attack(0.2)
    .decay(0.3)
    .sustain(0.5)
    .gain(0.3)
)
