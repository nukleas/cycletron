// Hard Industrial Acid Techno — 142 BPM
// Features: Distorted Rumble Kick, 303 Resonant Acid Lines, Struck-Metal Percussion, Multi-Section Arrangement

setbpm(142);

$: "<intro verse drop acid breakdown out>".slow(8).pickRestart({
  intro: stack(
    // Sub rumble kick build — filter creeps open across the section
    s("bd*4").gain(0.95).dist(0.45).shape(0.35).lpf(saw.range(1200, 2400).slow(8)),
    note("<[c1*4] [c1*4] [c1*4] [c1 c1 c1 bb0]>").s("sine")
      .attack(0.001).decay(0.32).sustain(0).release(0.4)
      .lpf(200).resonance(4).dist(0.5)
      .room(0.55).roomsize(0.85).gain(0.65),

    // Hats sneak in, then the ride
    s("<[hh*8] [hh*16] [hh*16] [hh*16]>").gain("0.2 0.3 0.25 0.35").hpf(6000).pan(0.35),
    s("<[~ ~ ~ ~] [~ ~ ~ ~] [~ ~ RolandTR909_rd ~] [~ ~ RolandTR909_rd ~]>").gain(0.3).hpf(5000).pan(0.7)
  ),

  verse: stack(
    // Kick + Sub Rumble
    s("bd*4").gain(0.95).dist(0.5).shape(0.4).lpf(2800),
    note("c1*4").s("sine")
      .attack(0.001).decay(0.32).sustain(0).release(0.4)
      .lpf(220).resonance(5).dist(0.55)
      .room(0.6).roomsize(0.85).gain(0.7),

    // Clapper & Snare
    s("~ cp ~ cp").gain(0.75).hpf(1200).dist(0.2).pan(0.5),
    s("hh*16").gain("0.25 0.45 0.3 0.5").hpf(6500).pan(0.3),

    // Metallic Percussion — tresillo rim + tom pickup
    s("RolandTR808_rim ~ ~ RolandTR808_rim ~ ~ RolandTR808_rim ~").gain(0.36).hpf(1800).dist(0.25).room(0.12).pan(0.35),
    s("<[~ ~ ~ ~] [~ ~ ~ [ht mt]]>").gain(0.35).crush(5).hpf(800).pan(0.65),

    // Industrial Rolling Synth Bass (16th-note drive)
    note("<c2 c2 c2 c2 c2 eb2 c2 f2>").fast(2)
      .s("sawtooth")
      .hpf(180)
      .lpf(sine.range(400, 2200).slow(8))
      .resonance(8)
      .dist(0.4)
      .gain(0.6)
  ),

  drop: stack(
    // Max Energy Distorted Kick + Sub Rumble
    s("bd*4").gain(1.0).dist(0.6).shape(0.45).lpf(3500),
    note("c1*4").s("sine")
      .attack(0.001).decay(0.35).sustain(0).release(0.42)
      .lpf(240).resonance(6).dist(0.6)
      .room(0.65).roomsize(0.85).gain(0.6),

    // Full Drum Grid: Snare, Offbeat Open Hat, Ride
    s("~ ~ sd ~").gain(0.7).hpf(1500).dist(0.3),
    s("~ cp ~ cp").gain(0.62).hpf(1000).pan(0.45),
    s("~ oh ~ oh").gain(0.45).hpf(4500).pan(0.65),
    s("hh*16").gain("0.25 0.4 0.3 0.45").hpf(7000).pan(0.3),

    // Metal & Stabs — tresillo rim + tom pickups
    s("RolandTR808_rim ~ ~ RolandTR808_rim ~ ~ RolandTR808_rim ~").gain(0.4).hpf(1800).dist(0.3).room(0.12).pan(0.35),
    s("<[~ ~ ~ [~ mt]] [~ ~ ~ [ht mt]]>").gain(0.4).crush(6).hpf(800).pan(0.65),
    note("c5(3,8)").s("wt_bell").gain(0.35).dist(0.3).lpf(6000).room(0.5).pan(0.75),

    // Rolling Industrial Bassline
    note("<c2 c2 c2 c2 c2 eb2 c2 g2>").fast(2)
      .s("sawtooth")
      .hpf(200)
      .lpf(3000)
      .resonance(10)
      .dist(0.45)
      .gain(0.65)
  ),

  acid: stack(
    // Full Beats
    s("bd*4").gain(1.0).dist(0.55).shape(0.4).lpf(3200),
    note("c1*4").s("sine").lpf(220).resonance(5).dist(0.5).room(0.6).gain(0.7),
    s("~ cp ~ cp").gain(0.8).hpf(1000),
    s("~ oh ~ oh").gain(0.65).hpf(4500).pan(0.6),
    s("hh*16").gain(0.4).hpf(6500),

    // Resonant 303 Acid Lead Line with Envelope Sweep & Accent Shifts
    note("<c2 c2 c3 c2 eb2 c2 f2 c2 f#2 c2 g2 c2 bb2 c2 c3 c2>")
      .s("superzow")
      .hpf(220)
      .lpf(sine.range(400, 4800).slow(4))
      .resonance(18)
      .dist(0.5)
      .decay(0.18)
      .sustain(0.1)
      .gain(0.75)
      .pan(0.4)
  ),

  breakdown: stack(
    // Sub Drone & Acid Sweep without Kicks
    note("c1").s("sine").lpf(180).gain(0.8),
    note("<c2 eb2 f2 g2>").s("superzow")
      .hpf(300)
      .lpf(sine.range(200, 3500).slow(8))
      .resonance(22)
      .dist(0.4)
      .decay(0.3)
      .gain(0.7)
      .pan(sine.range(0.2, 0.8).slow(4)),
    
    // Metallic Clangs in Space
    note("c5(3,8)").s("wt_bell").gain(0.3).dist(0.2).room(0.7).pan(0.7)
  ),

  out: stack(
    // Outro pulse
    s("bd*4").gain(0.85).lpf(1200),
    s("hh*8").gain(0.3).hpf(7000)
  )
})
