// Chicago / deep house · A minor · 124 BPM
setbpm(124);

"<hats groove@2 lift@2 fill>".slow(4).pickRestart({
  hats: stack(
    s("hh*8").gain("[0.18 0.10]*4"),
    s("[~ oh]*4").gain(0.28)
  ).bank("RolandTR909"),

  groove: stack(
    stack(
      s("bd*4").gain(0.9),
      s("[~ oh]*4").gain(0.36),
      s("~ cp ~ cp").gain(0.55),
      s("hh*16").gain("[0.16 0.09]*8")
    ).bank("RolandTR909"),
    note("~ a1 ~ a1 ~ a1 ~ a2").s("sawtooth")
      .lpf(480).resonance(6).gain(0.5),
    note("a1 ~ a1 ~ a1 ~ a1 ~").s("sine").lpf(160).gain(0.4)
  ),

  lift: stack(
    stack(
      s("bd*4").gain(0.92),
      s("[~ oh]*4").gain(0.38),
      s("~ cp ~ cp").gain(0.58),
      s("hh*16").gain("[0.18 0.10]*8")
    ).bank("RolandTR909"),
    s("~ RolandTR909_rd ~ RolandTR909_rd").hpf(4000).gain(0.12),
    note("~ a1 ~ a1 ~ a1 ~ a2").s("sawtooth")
      .lpf(sine.range(450, 1400).slow(8)).resonance(7).gain(0.5),
    chord("<Am7 Dm7 Em7 Am7>").voicing().s("sawtooth")
      .struct("~ 1 ~ 1").release(0.16).lpf(1900).gain(0.38).room(0.3),
    note("a4 ~ c5 ~ e5 ~ g5 a4 ~ e5 ~ c5 ~ a4 ~")
      .s("triangle").delay(0.25).delaytime(0.375).room(0.28).gain(0.28)
  ),

  fill: stack(
    stack(
      s("bd*4").gain(0.9),
      s("~ cp ~ cp").gain(0.5),
      s("hh*8").gain(0.16),
      s("~ ~ ~ sd*8").gain(0.38)
    ).bank("RolandTR909"),
    note("~ a1 ~ a1 ~ a1 ~ a2").s("sawtooth").lpf(700).resonance(6).gain(0.45)
  )
})
