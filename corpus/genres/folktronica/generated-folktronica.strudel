// folktronica in G major (generated) — soft boom-bap, upright bass, kalimba line
setbpm(110);

stack(
  s("bd ~ ~ ~ ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ ~, ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~").gain(0.71).every(4, x => x.fast(2)),
  note("g2 ~ d3 ~ g2 ~ f#3 ~").s("gm_acoustic_bass").gain(0.49),
  note("<[g3, b3, d4, f#4] [d4, f#4, a4, c5] [e4, g4, b4, d5] [c4, e4, g4, b4]>").s("wt_piano").release(0.5).gain(0.34).room(0.4).pan(0.42),
  note("<[d5 ~ f#5 ~ c5 ~ b4 ~] [d5 ~ f#5 ~ c5 ~ b4 ~] [f#5 ~ a5 ~ e5 ~ d5 ~] [b4 ~ b4 ~ d5 ~ d5 ~]>").s("gm_kalimba").room(0.4).delay(0.25).gain(0.28).pan(0.62)
)
