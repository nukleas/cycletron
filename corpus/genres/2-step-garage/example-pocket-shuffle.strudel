// Pocket Shuffle — 2-step garage essentials · G minor · 130 BPM
setbpm(130);

stack(
  s("bd ~ ~ ~ ~ ~ bd ~ ~ ~ bd ~ ~ ~ ~ ~, ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~")
    .gain(0.72),
  s("~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh")
