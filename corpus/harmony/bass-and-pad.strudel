// Two-voice texture: walking bass beneath a sustained pad.
// The pad uses a slow attack so it doesn't compete with the bass transient.
setbpm(84);

stack(
  note("c2 g2 a2 e2")
    .s("sawtooth")
    .cutoff(600)
    .gain(0.65),
  note("c4 e4 g4 b4")
    .s("triangle")
    .attack(0.4)
    .release(0.8)
    .gain(0.35)
    .slow(2)
)
