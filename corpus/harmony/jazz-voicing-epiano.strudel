// Jazz ii-V-I voiced chords on electric piano with walking bass.
setbpm(112);

stack(
  chord("<Dm7 G7 Cmaj7 A7>")
    .voicing()
    .s("gm_epiano1")
    .slow(2)
    .attack(0.04)
    .release(0.9)
    .gain(0.42)
    .room(0.3),
  note("<[d2 f2] [g2 b2] [c2 e2] [a2 c3]>")
    .s("gm_acoustic_bass")
    .slow(2)
    .release(0.4)
    .gain(0.65)
)
