-        // Parse operators
+        // Parse operators.
         loop {
+            // `@N` and `_` are weight-only modifiers — they consume tokens
+            // but don't produce a SliceOp. Handle them up front and
+            // `continue` so that any subsequent operator (e.g. `*M` after
+            // `@N`) is still parsed by this loop rather than leaking into
+            // the outer sequence parser.
+            match self.peek() {
+                Some((Token::At, _)) => {
+                    self.next();
+                    let amount = if let Some((Token::Number(n), _)) = self.peek() {
+                        self.next();
+                        n
+                    } else {
+                        2.0 // default weight increment
+                    };
+                    element.weight += amount - 1.0;
+                    continue;
+                }
+                Some((Token::Underscore, _)) => {
+                    self.next();
+                    element.weight += 1.0;
+                    continue;
+                }
+                _ => {}
+            }
