+
+    // ---- Regression tests for `@N` followed by another modifier. ----
+    // Bug: `parse_slice_with_ops` broke out of its modifier loop after
+    // seeing `@N`, so any following operator was abandoned and the next
+    // sibling element got swallowed.
+
+    #[test]
+    fn test_parse_at_then_star() {
+        let ast = parse("a4@2*2").unwrap();
+        unwrap_variant!(ast, Ast::Pattern(p));
+        assert_eq!(p.children.len(), 1);
+        unwrap_variant!(&p.children[0], Ast::Element(e));
+        assert!((e.weight - 2.0).abs() < 1e-9, "weight should be 2, got {}", e.weight);
+        assert!(
+            matches!(&e.ops[..], [SliceOp::Stretch { op_type: StretchType::Fast, .. }]),
+            "expected single Stretch op, got {:?}",
+            e.ops
+        );
+    }
+
+    #[test]
+    fn test_parse_at_then_star_with_sibling() {
+        // `a4@2*2 e4` must yield two top-level children — the sibling
+        // must not be swallowed by the modifier loop.
+        let ast = parse("a4@2*2 e4").unwrap();
+        unwrap_variant!(ast, Ast::Pattern(p));
+        assert_eq!(p.children.len(), 2, "expected 2 children, got {}", p.children.len());
+    }
+
+    #[test]
+    fn test_parse_underscore_then_star() {
+        let ast = parse("a4_*2").unwrap();
+        unwrap_variant!(ast, Ast::Pattern(p));
+        unwrap_variant!(&p.children[0], Ast::Element(e));
+        assert!((e.weight - 2.0).abs() < 1e-9, "weight should be 2, got {}", e.weight);
+        assert!(
+            matches!(&e.ops[..], [SliceOp::Stretch { op_type: StretchType::Fast, .. }]),
+            "expected single Stretch op, got {:?}",
+            e.ops
+        );
+    }
+
+    #[test]
+    fn test_parse_double_at() {
+        // Two `@` modifiers should stack: weight=1 + (2-1) + (3-1) = 3.
+        let ast = parse("a4@2@3").unwrap();
+        unwrap_variant!(ast, Ast::Pattern(p));
+        unwrap_variant!(&p.children[0], Ast::Element(e));
+        assert!((e.weight - 3.0).abs() < 1e-9, "weight should be 3, got {}", e.weight);
+    }
+
+    #[test]
+    fn test_parse_at_then_star_inside_brackets() {
+        // `[a4 e4@2]@2 c4` — outer @2 on a bracket, with a sibling.
+        let ast = parse("[a4 e4@2]@2 c4").unwrap();
+        unwrap_variant!(ast, Ast::Pattern(p));
+        assert_eq!(p.children.len(), 2, "expected 2 top-level children");
+    }
 }
