// Sustained low drone underneath a moving voice — common in modal music.
// `slow(4)` keeps the drone steady for four cycles before retriggering.
setbpm(72);

stack(
  note("a2").s("sawtooth").attack(0.6).release(2.0).gain(0.5).slow(4),
  note("a4 c5 e5 d5 c5 b4 a4 g4")
    .s("triangle")
    .cutoff(2000)
    .attack(0.02)
    .release(0.3)
    .gain(0.45)
)
