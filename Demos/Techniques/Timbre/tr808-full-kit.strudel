// TR-808 full kit groove demonstrating all ten drum voices.
setbpm(120);

stack(
  s("RolandTR808_bd ~ RolandTR808_bd ~").gain(0.85),
  s("~ RolandTR808_sd ~ RolandTR808_sd").gain(0.7),
  s("RolandTR808_hh*8").gain(0.25),
  s("~ ~ ~ RolandTR808_oh").gain(0.42),
  s("~ ~ RolandTR808_cp ~").gain(0.62),
  s("RolandTR808_rim ~ ~ ~").gain(0.5),
  s("RolandTR808_lt ~ ~ RolandTR808_mt ~ ~ RolandTR808_ht ~").gain(0.55),
  s("~ ~ ~ ~ RolandTR808_cb ~ ~ ~").gain(0.48)
)
