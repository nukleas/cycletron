// 8-bar developing lead — a phrase that climbs and answers itself instead of
// looping one bar. Each [] group is one bar of scale degrees; the line arcs up
// the C-major scale in call-and-response pairs, then resolves to the tonic.
// Use this shape inside long sections (a `.slow(8)` pickRestart label) so the
// melody actually moves across the section rather than repeating a single bar.
setbpm(120);
note("<[0 2 4 ~] [4 2 0 ~] [4 5 7 ~] [7 5 4 ~] [7 9 11 ~] [11 9 7 ~] [7 4 2 ~] [0 ~ ~ ~]>")
  .scale("C4:major")
  .s("wt_lead")
  .release(0.3)
  .cutoff(2200)
  .gain(0.4)
