    note("<[0 4 7 4 9 7 4 0] [2 4 7 4 9 7 4 2] [4 7 9 7 12 9 7 4] [7 ~ 4 ~ ~ ~ ~ ~]>")
      .scale("F#5:minor").s("pulse").decay(0.12).sustain(0)
