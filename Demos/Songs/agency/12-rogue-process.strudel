      .gain(0.24).pan(sine.range(0.4, 0.6)),
    note("<[f#1 f#1 ~ f#1 ~ f#1 f#1 ~ ~ f#1 f#1 ~ f#2 ~ ~ ~] [f#1 f#1 ~ f#1 ~ f#1 f#1 ~ a1 ~ a1 ~ g#1 ~ ~ ~] [f#1 f#1 ~ f#1 ~ f#1 f#1 ~ ~ f#1 f#1 ~ f#2 ~ ~ ~] [d1 ~ ~ d1 ~ ~ e1 ~ e1 ~ ~ ~ ~ ~ ~ ~] [f#1 f#1 ~ f#1 ~ f#1 f#1 ~ ~ f#1 f#1 ~ f#2 ~ ~ ~] [f#1 f#1 ~ f#1 ~ f#1 f#1 ~ a1 ~ a1 ~ g#1 ~ ~ ~] [b1 ~ ~ b1 ~ ~ a1 ~ g#1 ~ ~ g#1 e1 ~ ~ ~] [f#1 ~ f#1 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]>")
      .s("sawtooth").lpf(850).resonance(9)
      .decay(0.09).sustain(0).dist(0.32).gain(0.56),
    note("<[0 4 7 4 9 7 4 0] [2 4 7 4 9 7 4 2] [0 4 7 4 9 7 4 0] [7 9 11 9 12 11 9 7] [0 4 7 4 9 7 4 0] [2 4 7 4 9 7 4 2] [4 7 9 7 12 9 7 4] [7 ~ 4 ~ ~ ~ ~ ~]>")
      .scale("F#4:minor").s("pulse").decay(0.12).sustain(0)
      .delay(0.25).delaytime(0.1875).room(0.3).gain(0.3).pan(0.6),
    chord("<F#m F#m D E>").voicing().s("supersaw")
