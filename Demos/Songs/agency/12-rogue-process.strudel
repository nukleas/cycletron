    note("<[12 ~ 11 ~ 9 ~ 7 ~] [9 ~ 7 ~ 4 ~ ~ ~] [14 ~ 12 ~ 11 ~ 9 ~] [7 ~ ~ ~ ~ ~ ~ ~]>")
      .scale("F#4:minor").s("sawtooth")
      .lpf(3200).resonance(6).decay(0.18).sustain(0.1)
      .dist(0.2).delay(0.22).delaytime(0.1875).room(0.3).gain(0.34)
  ),
  outro: stack(
    note("<[0 4 7 4 ~ 4 7 ~] [0 ~ 7 ~ ~ 4 ~ ~] [0 ~ 4 ~ 7 ~ ~ ~] [~ ~ ~ ~ 7 ~ ~ ~]>")
      .scale("F#4:minor").s("pulse").decay(0.12).sustain(0)
      .delay(0.4).delaytime(0.1875).delayfeedback(0.5)
      .room(0.5).gain(isaw.range(0.1, 0.28).slow(8)).pan(0.6),
    note("f#1").s("sine").slow(2).attack(1.5).release(3).gain(0.42),
    chord("<F#m F#m D F#m>").voicing().s("supersaw")
