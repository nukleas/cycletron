    s("~ ~ ~ oh").gain(0.26),
    note("<[f#1 f#1 ~ f#1 ~ f#1 f#1 ~ ~ f#1 f#1 ~ f#2 ~ ~ ~] [f#1 f#1 ~ f#1 ~ f#1 f#1 ~ a1 ~ a1 ~ g#1 ~ ~ ~] [b1 ~ ~ b1 ~ ~ a1 ~ g#1 ~ ~ g#1 e1 ~ ~ ~] [f#1 ~ f#1 ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~ ~]>")
      .s("sawtooth").lpf(1100).resonance(9)
