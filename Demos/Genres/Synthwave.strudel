// synthwave in A minor (generated) — gated rock beat, octave synth bass, neon arp
setbpm(101);

stack(
  s("bd ~ ~ ~ ~ ~ ~ ~ bd ~ ~ ~ ~ ~ ~ ~, ~ ~ ~ ~ sd ~ ~ ~ ~ ~ ~ ~ sd ~ ~ ~, hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~ hh ~").gain(0.9).room(0.4),
  note("a2 ~ a3 ~ a2 ~ a3 ~").s("sawtooth").lpf(750).resonance(6).gain(0.5),
  note("<[a3, c4, e4, g4] [f4, a4, c5, e5] [g4, b4, d5, f5] [e4, g4, b4, d5]>").s("wt_pad").attack(0.6).release(1.5).lpf(1600).gain(0.32).room(0.5).pan(0.42),
  note("a4 c5 e5 a5").s("wt_lead").delay(0.35).room(0.45).gain(0.32).pan(0.62)
)
